{
  "quirk": "The legacy mode yolo auto-approves every tool call: choosing the Span mode Full sends session/set_mode yolo and raises the permissionsBypassed warning Notice; choosing Ask sends default and clears it.",
  "drive": [
    {
      "do": "newSession"
    },
    {
      "do": "setPermissionMode",
      "mode": "full"
    },
    {
      "do": "setPermissionMode",
      "mode": "ask"
    }
  ],
  "events": [
    {
      "kind": "config"
    },
    {
      "kind": "_step",
      "do": "newSession"
    },
    {
      "kind": "config"
    },
    {
      "kind": "notice",
      "severity": "warning",
      "title": "YOLO",
      "noticeId": "span/permission-bypass",
      "hint": "permissionsBypassed"
    },
    {
      "kind": "_step",
      "do": "setPermissionMode"
    },
    {
      "kind": "config"
    },
    {
      "kind": "noticeCleared",
      "noticeId": "span/permission-bypass"
    },
    {
      "kind": "_step",
      "do": "setPermissionMode"
    }
  ],
  "counts": [
    {
      "match": {
        "kind": "notice",
        "hint": "permissionsBypassed"
      },
      "count": 1
    }
  ]
}
