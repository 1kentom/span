// Auto on Gemini CLI (legacy modes): the agent stays in default. A plain git status is allowed by Span without a prompt (auto_safe_command), a command with shell syntax prompts, and a workspace edit is allowed (accept_edits_workspace). Plan is not offered (no plan mode over ACP). When Gemini switches itself to yolo, Span reports modeMismatch and sends session/set_mode default once.
// Legacy mode shapes from gemini-cli source, as gemini/legacy-config. Not run live.
{"on": "initialize", "result": {"protocolVersion": 1, "agentCapabilities": {"loadSession": true}, "authMethods": [], "agentInfo": {"name": "gemini-cli", "version": "0.46.0"}}}
{"on": "session/new", "result": {"sessionId": "g-1", "modes": {"currentModeId": "default", "availableModes": [{"id": "default", "name": "Default"}, {"id": "autoEdit", "name": "Auto Edit"}, {"id": "yolo", "name": "YOLO"}]}}}
{"on": "session/set_mode", "result": {}}
{"on": "session/prompt", "before": [{"request": {"method": "session/request_permission", "params": {"toolCall": {"toolCallId": "x1", "title": "Shell git status", "kind": "execute", "status": "pending", "rawInput": {"command": "git status"}}, "options": [{"optionId": "allow", "name": "Allow", "kind": "allow_once"}, {"optionId": "always", "name": "Always allow", "kind": "allow_always"}, {"optionId": "reject", "name": "Reject", "kind": "reject_once"}]}}}, {"request": {"method": "session/request_permission", "params": {"toolCall": {"toolCallId": "x2", "title": "Shell", "kind": "execute", "status": "pending", "rawInput": {"command": "git status && rm -rf src"}}, "options": [{"optionId": "allow", "name": "Allow", "kind": "allow_once"}, {"optionId": "always", "name": "Always allow", "kind": "allow_always"}, {"optionId": "reject", "name": "Reject", "kind": "reject_once"}]}}}, {"request": {"method": "session/request_permission", "params": {"toolCall": {"toolCallId": "e1", "title": "WriteFile a.txt", "kind": "edit", "status": "pending", "rawInput": {"file_path": "$ROOT/a.txt"}, "locations": [{"path": "$ROOT/a.txt"}]}, "options": [{"optionId": "allow", "name": "Allow", "kind": "allow_once"}, {"optionId": "always", "name": "Always allow", "kind": "allow_always"}, {"optionId": "reject", "name": "Reject", "kind": "reject_once"}]}}}, {"update": {"sessionUpdate": "current_mode_update", "currentModeId": "yolo"}}, {"sleep": 300}], "result": {"stopReason": "end_turn"}}
