// OpenCode 2.x lists its own subagent sessions beside the user's chats with no parent field: the parent's stream names them (_meta["opencode/child-session"] id and parentID on projected child updates, rawOutput.metadata.sessionID on the subagent tool result, tool kind think), and a replay whose first user message starts with the subagent preamble marks that session. The listing marks those, plus the exact untitled child title and the 1.x " (@agent subagent)" title; near-miss titles and messages stay ordinary chats.
// Recorded shape from anomalyco/opencode 2.2.1 source (packages/cli/src/acp/service.ts, child.ts, tool.ts; packages/core/src/tool/plugin/subagent.ts). Not captured from a live agent.
{"on": "initialize", "result": {"protocolVersion": 1, "agentCapabilities": {"loadSession": true, "promptCapabilities": {"image": true, "embeddedContext": true}, "mcpCapabilities": {"http": true, "sse": false}, "sessionCapabilities": {"additionalDirectories": {}, "close": {}, "delete": {}, "fork": {}, "list": {}, "resume": {}}, "_meta": {"opencode/child-session-updates": true}}, "authMethods": [{"id": "opencode-login", "name": "Login with opencode", "description": "Run `opencode auth login` in the terminal"}], "agentInfo": {"name": "OpenCode", "version": "2.2.1"}}}
{"on": "session/new", "result": {"sessionId": "ses_np_parent"}}
{"on": "session/prompt", "before": [{"update": {"sessionUpdate": "tool_call", "toolCallId": "prt_sub1", "title": "Generate BMW M2 PNG image", "kind": "think", "status": "pending", "rawInput": {"description": "Generate BMW M2 PNG image", "prompt": "Create a high-resolution PNG image of a BMW M2", "subagent_type": "general"}}}, {"update": {"sessionUpdate": "agent_message_chunk", "messageId": "msg_c1", "content": {"type": "text", "text": "Rendering"}, "_meta": {"opencode/child-session": {"id": "ses_np_bmw", "parentID": "ses_np_parent", "depth": 1, "title": "Generate BMW M2 PNG image"}}}}, {"update": {"sessionUpdate": "tool_call_update", "toolCallId": "prt_sub1", "status": "completed", "content": [], "rawOutput": {"metadata": {"sessionID": "ses_np_bmw", "status": "completed"}}}}, {"update": {"sessionUpdate": "tool_call", "toolCallId": "prt_sub2", "title": "Review the image", "kind": "think", "status": "pending"}}, {"update": {"sessionUpdate": "tool_call_update", "toolCallId": "prt_sub2", "status": "completed", "content": [], "rawOutput": {"metadata": {"sessionID": "ses_np_review", "status": "completed"}}}}, {"update": {"sessionUpdate": "tool_call", "toolCallId": "prt_read", "title": "read", "kind": "read", "status": "pending"}}, {"update": {"sessionUpdate": "tool_call_update", "toolCallId": "prt_read", "status": "completed", "content": [], "rawOutput": {"metadata": {"sessionID": "ses_np_not_a_child"}}}}, {"update": {"sessionUpdate": "agent_message_chunk", "messageId": "msg_p1", "content": {"type": "text", "text": "Done"}}}], "result": {"stopReason": "end_turn"}}
