// First tool_call is pending with rawInput {} and the raw tool name as title; completed omits title, kind and rawInput; in_progress repeats unchanged. Updates merge per toolCallId, repeats are dropped, the title is a placeholder until in_progress.
// Recorded shape from anomalyco/opencode 2.2.0 source. Not captured from a live agent.
{"on": "initialize", "result": {"protocolVersion": 1, "agentCapabilities": {"loadSession": true, "promptCapabilities": {"image": true, "embeddedContext": true}, "mcpCapabilities": {"http": true, "sse": false}}, "authMethods": [{"id": "opencode-login", "name": "Login with opencode", "description": "Run `opencode auth login` in the terminal"}], "agentInfo": {"name": "OpenCode", "version": "2.2.0"}}}
{"on": "session/new", "result": {"sessionId": "ses_1"}}
{"on": "session/prompt", "before": [{"update": {"sessionUpdate": "tool_call", "toolCallId": "call_1", "title": "bash", "name": "bash", "kind": "execute", "status": "pending", "rawInput": {}, "locations": []}}, {"update": {"sessionUpdate": "tool_call_update", "toolCallId": "call_1", "status": "in_progress", "title": "List files", "kind": "execute", "rawInput": {"command": "ls"}, "locations": [{"path": "$ROOT"}]}}, {"update": {"sessionUpdate": "tool_call_update", "toolCallId": "call_1", "status": "in_progress", "title": "List files", "kind": "execute", "rawInput": {"command": "ls"}, "locations": [{"path": "$ROOT"}]}}, {"update": {"sessionUpdate": "tool_call_update", "toolCallId": "call_1", "status": "completed", "content": [{"type": "content", "content": {"type": "text", "text": "a\nb"}}], "rawOutput": {"output": "a\nb"}}}], "result": {"stopReason": "end_turn"}}
