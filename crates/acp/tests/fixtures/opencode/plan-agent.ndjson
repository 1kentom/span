// Plan on OpenCode: Span switches the session to the plan agent. A bash request is refused by Span without a prompt (plan_mode_read_only). When OpenCode moves back to the build agent on its own, Span reports modeMismatch and sets plan back once.
// Mode option shape as OpenCode 2.0.32 live captures (sanitised). Not run live.
{"on": "initialize", "result": {"protocolVersion": 1, "agentCapabilities": {"loadSession": true}, "authMethods": [], "agentInfo": {"name": "OpenCode", "version": "2.0.32"}}}
{"on": "session/new", "result": {"sessionId": "ses_1", "configOptions": [{"id": "mode", "name": "Session Mode", "category": "mode", "type": "select", "currentValue": "build", "options": [{"value": "build", "name": "build"}, {"value": "plan", "name": "plan"}]}]}}
{"on": "session/set_config_option", "result": {"configOptions": [{"id": "mode", "name": "Session Mode", "category": "mode", "type": "select", "currentValue": "plan", "options": [{"value": "build", "name": "build"}, {"value": "plan", "name": "plan"}]}]}}
{"on": "session/prompt", "before": [{"request": {"method": "session/request_permission", "params": {"toolCall": {"toolCallId": "b1", "title": "bash", "kind": "execute", "status": "pending", "rawInput": {"command": "ls"}}, "options": [{"optionId": "allow", "name": "Allow", "kind": "allow_once"}, {"optionId": "always", "name": "Always allow", "kind": "allow_always"}, {"optionId": "reject", "name": "Reject", "kind": "reject_once"}]}}}, {"update": {"sessionUpdate": "config_option_update", "configOptions": [{"id": "mode", "name": "Session Mode", "category": "mode", "type": "select", "currentValue": "build", "options": [{"value": "build", "name": "build"}, {"value": "plan", "name": "plan"}]}]}}, {"sleep": 300}], "result": {"stopReason": "end_turn"}}
