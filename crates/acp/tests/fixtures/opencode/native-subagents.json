          "ses_np_v1",
          null
        ],
        [
          "ses_np_old",
          null
        ]
      ]
    }
  ],
  "events": [
    {
      "kind": "_step",
      "do": "listSessions",
      "ok": true
    },
    {
      "kind": "user",
      "text": "You are a subagent spawned by another session.\nResearch the old API and summarise it"
