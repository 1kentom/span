        "ses_np_chat1",
        "ses_np_chat2",
        "ses_np_chat3",
        "ses_np_not_a_child"
      ],
      "expectNative": [
        [
          "ses_np_bmw",
          "ses_np_parent"
        ],
        [
          "ses_np_review",
          "ses_np_parent"
        ],
        [
          "ses_np_untitled",
          null
        ],
        [
          "ses_np_v1",
          null
        ]
      ]
    },
    {
      "do": "load",
      "session": "ses_np_old"
    },
    {
