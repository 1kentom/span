      "name": "local",
      "command": "node",
      "args": [],
      "env": []
    },
    {
      "type": "http",
      "name": "remote",
      "url": "https://mcp.example",
      "headers": []
    },
    {
      "type": "sse",
      "name": "events",
      "url": "https://sse.example",
      "headers": []
    }
  ],
  "drive": [
    {
      "do": "newSession"
    }
  ],
  "sent": [
    {
      "method": "session/new",
