// _auth/status_update carries the account email, plan and organization: its params are redacted from the protocol log (the method name stays), so neither log lines nor the Debug output of any event contain them.
// Shapes from live captures of claude-agent-acp 0.98.0 and codex-acp 2.3.0 (sanitised; the address is a placeholder).
{"on": "initialize", "result": {"protocolVersion": 1, "agentCapabilities": {"promptCapabilities": {"image": true, "embeddedContext": true}, "mcpCapabilities": {"http": true, "sse": true}, "loadSession": true, "sessionCapabilities": {"close": {}, "delete": {}, "list": {}, "resume": {}}}, "agentInfo": {"name": "@agentclientprotocol/claude-agent-acp", "title": "Claude Agent", "version": "0.98.0"}, "authMethods": []}}
{"on": "session/new", "before": [{"notify": {"method": "_auth/status_update", "params": {"authStatus": {"kind": "account", "label": "Claude Max", "account": {"plan": "Claude Max", "email": "person@example.com", "organization": "person@example.com's Organization"}}}}}, {"notify": {"method": "_auth/status_update", "params": {"authStatus": {"kind": "account", "label": "ChatGPT Pro", "account": {"email": "person@example.com", "plan": "pro"}}}}}, {"sleep": 50}], "result": {"sessionId": "312c639d-40d2-4a77-9313-3c2610f18f00"}}
