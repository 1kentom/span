// Plan mode on Claude: the user picks Plan, Span sets mode plan. While the thread is in Plan, Span answers edit, execute and switch_mode (ExitPlanMode) requests itself with reject once and reason plan_mode_read_only, logged as permissionAuto and never shown as a prompt; a read request still prompts. When Claude leaves plan mode on its own (current_mode_update default), Span reports modeMismatch, sets plan back once and reports it resolved.
// Shapes as claude-agent-acp 0.98.0 (mode option from a live capture, ExitPlanMode as a switch_mode permission from its source). Not run live.
{"on": "initialize", "result": {"protocolVersion": 1, "agentCapabilities": {"promptCapabilities": {"image": true, "embeddedContext": true}, "loadSession": true, "sessionCapabilities": {"close": {}, "list": {}}}, "agentInfo": {"name": "@agentclientprotocol/claude-agent-acp", "title": "Claude Agent", "version": "0.98.0"}, "authMethods": []}}
{"on": "session/new", "result": {"sessionId": "c-1", "configOptions": [{"id": "mode", "name": "Mode", "category": "mode", "type": "select", "currentValue": "default", "options": [{"value": "default", "name": "Manual"}, {"value": "acceptEdits", "name": "Accept edits"}, {"value": "plan", "name": "Plan"}, {"value": "auto", "name": "Auto"}, {"value": "bypassPermissions", "name": "Bypass permissions"}]}, {"id": "model", "name": "Model", "category": "model", "type": "select", "currentValue": "sonnet", "options": [{"value": "sonnet", "name": "Sonnet"}]}]}}
{"on": "session/set_config_option", "before": [{"update": {"sessionUpdate": "current_mode_update", "currentModeId": "plan"}}], "result": {"configOptions": [{"id": "mode", "name": "Mode", "category": "mode", "type": "select", "currentValue": "plan", "options": [{"value": "default", "name": "Manual"}, {"value": "acceptEdits", "name": "Accept edits"}, {"value": "plan", "name": "Plan"}, {"value": "auto", "name": "Auto"}, {"value": "bypassPermissions", "name": "Bypass permissions"}]}, {"id": "model", "name": "Model", "category": "model", "type": "select", "currentValue": "sonnet", "options": [{"value": "sonnet", "name": "Sonnet"}]}]}}
{"on": "session/prompt", "before": [{"request": {"method": "session/request_permission", "params": {"toolCall": {"toolCallId": "e1", "title": "Edit src/a.rs", "kind": "edit", "status": "pending", "rawInput": {"file_path": "$ROOT/src/a.rs"}, "locations": [{"path": "$ROOT/src/a.rs"}]}, "options": [{"optionId": "allow", "name": "Allow", "kind": "allow_once"}, {"optionId": "always", "name": "Always allow", "kind": "allow_always"}, {"optionId": "reject", "name": "Reject", "kind": "reject_once"}]}}}, {"request": {"method": "session/request_permission", "params": {"toolCall": {"toolCallId": "x1", "title": "git status", "kind": "execute", "status": "pending", "rawInput": {"command": "git status"}}, "options": [{"optionId": "allow", "name": "Allow", "kind": "allow_once"}, {"optionId": "always", "name": "Always allow", "kind": "allow_always"}, {"optionId": "reject", "name": "Reject", "kind": "reject_once"}]}}}, {"request": {"method": "session/request_permission", "params": {"toolCall": {"toolCallId": "r1", "title": "Read present.txt", "kind": "read", "status": "pending", "rawInput": {"file_path": "$ROOT/present.txt"}, "locations": [{"path": "$ROOT/present.txt"}]}, "options": [{"optionId": "allow", "name": "Allow", "kind": "allow_once"}, {"optionId": "always", "name": "Always allow", "kind": "allow_always"}, {"optionId": "reject", "name": "Reject", "kind": "reject_once"}]}}}, {"request": {"method": "session/request_permission", "params": {"toolCall": {"toolCallId": "p1", "title": "Ready to code?", "kind": "switch_mode", "status": "pending", "rawInput": {"plan": "1. Add the module\n2. Test it"}}, "options": [{"optionId": "allow", "name": "Allow", "kind": "allow_once"}, {"optionId": "always", "name": "Always allow", "kind": "allow_always"}, {"optionId": "reject", "name": "Reject", "kind": "reject_once"}]}}}, {"update": {"sessionUpdate": "current_mode_update", "currentModeId": "default"}}, {"sleep": 300}], "result": {"stopReason": "end_turn"}}
