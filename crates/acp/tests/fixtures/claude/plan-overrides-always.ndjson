// An edit the user allowed for good in Ask (allow_always, remembered for the session) is still refused once the thread is in Plan: the Span mode answers before any remembered answer (the T3 Code leak where an auto mode plus plan silently approved writes).
// Shapes as claude-agent-acp 0.98.0 (mode option from a live capture, ExitPlanMode as a switch_mode permission from its source). Not run live.
{"on": "initialize", "result": {"protocolVersion": 1, "agentCapabilities": {"promptCapabilities": {"image": true, "embeddedContext": true}, "loadSession": true, "sessionCapabilities": {"close": {}, "list": {}}}, "agentInfo": {"name": "@agentclientprotocol/claude-agent-acp", "title": "Claude Agent", "version": "0.98.0"}, "authMethods": []}}
{"on": "session/new", "result": {"sessionId": "c-1", "configOptions": [{"id": "mode", "name": "Mode", "category": "mode", "type": "select", "currentValue": "default", "options": [{"value": "default", "name": "Manual"}, {"value": "acceptEdits", "name": "Accept edits"}, {"value": "plan", "name": "Plan"}, {"value": "auto", "name": "Auto"}, {"value": "bypassPermissions", "name": "Bypass permissions"}]}, {"id": "model", "name": "Model", "category": "model", "type": "select", "currentValue": "sonnet", "options": [{"value": "sonnet", "name": "Sonnet"}]}]}}
{"on": "session/set_config_option", "result": {"configOptions": [{"id": "mode", "name": "Mode", "category": "mode", "type": "select", "currentValue": "plan", "options": [{"value": "default", "name": "Manual"}, {"value": "acceptEdits", "name": "Accept edits"}, {"value": "plan", "name": "Plan"}, {"value": "auto", "name": "Auto"}, {"value": "bypassPermissions", "name": "Bypass permissions"}]}, {"id": "model", "name": "Model", "category": "model", "type": "select", "currentValue": "sonnet", "options": [{"value": "sonnet", "name": "Sonnet"}]}]}}
{"on": "session/prompt", "before": [{"request": {"method": "session/request_permission", "params": {"toolCall": {"toolCallId": "e1", "title": "Edit src/a.rs", "kind": "edit", "status": "pending", "rawInput": {"file_path": "$ROOT/src/a.rs"}, "locations": [{"path": "$ROOT/src/a.rs"}]}, "options": [{"optionId": "allow", "name": "Allow", "kind": "allow_once"}, {"optionId": "always", "name": "Always allow", "kind": "allow_always"}, {"optionId": "reject", "name": "Reject", "kind": "reject_once"}]}}}], "result": {"stopReason": "end_turn"}}
{"on": "session/prompt", "before": [{"request": {"method": "session/request_permission", "params": {"toolCall": {"toolCallId": "e2", "title": "Edit src/a.rs", "kind": "edit", "status": "pending", "rawInput": {"file_path": "$ROOT/src/a.rs"}, "locations": [{"path": "$ROOT/src/a.rs"}]}, "options": [{"optionId": "allow", "name": "Allow", "kind": "allow_once"}, {"optionId": "always", "name": "Always allow", "kind": "allow_always"}, {"optionId": "reject", "name": "Reject", "kind": "reject_once"}]}}}], "result": {"stopReason": "end_turn"}}
