      "sessionId": "x-1",
      "options": [
        {
          "id": "mode",
          "currentValue": "agent"
        },
        {
          "id": "collaboration_mode"
        }
      ]
    },
    {
      "kind": "_step",
      "do": "newSession",
      "ok": true
    }
  ],
  "absent": [
    {
      "kind": "notice",
      "hint": "permissionsBypassed"
    }
  ],
  "sent": [
    {
      "method": "session/set_config_option",
      "params": {
        "sessionId": "x-1",
        "configId": "mode",
        "value": "agent"
      }
    }
  ],
  "notSent": [
    {
      "method": "session/new",
      "params": {
        "_meta": {}
      }
    }
  ]
