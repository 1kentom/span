{
  "quirk": "A global Codex config with approval_policy never and danger-full-access starts sessions in agent-full-access. Under the default approval start mode Span changes the mode to agent (Auto review, codex-acp's own default) at session start: the mode chip shows Auto review and no bypass notice is raised. Codex gets no _meta.",
  "drive": [
    {
      "do": "newSession"
    }
  ],
  "events": [
    {
      "kind": "session",
      "sessionId": "x-1"
    },
    {
