{
  "quirk": "Choosing the Span mode Full sets codex-acp to agent-full-access, which lets Codex run without asking: a warning Notice with hint permissionsBypassed appears and is cleared when the thread moves to Plan (read-only plus the plan collaboration mode). The default agent (Auto review) mode raises nothing.",
  "drive": [
    {
      "do": "newSession"
    },
    {
      "do": "setPermissionMode",
      "mode": "full"
    },
    {
      "do": "setPermissionMode",
      "mode": "plan"
    }
  ],
  "events": [
    {
      "kind": "config"
    },
    {
      "kind": "_step",
      "do": "newSession"
    },
    {
      "kind": "config"
    },
    {
      "kind": "notice",
      "severity": "warning",
      "title": "Full access",
      "noticeId": "span/permission-bypass",
      "hint": "permissionsBypassed"
    },
    {
      "kind": "_step",
      "do": "setPermissionMode"
    },
    {
      "kind": "config"
    },
    {
      "kind": "noticeCleared",
      "noticeId": "span/permission-bypass"
    },
    {
      "kind": "_step",
      "do": "setPermissionMode"
    }
  ],
  "counts": [
    {
      "match": {
        "kind": "notice",
        "hint": "permissionsBypassed"
      },
      "count": 1
    },
    {
      "match": {
        "kind": "noticeCleared"
      },
      "count": 1
    }
  ],
  "sent": [
    {
      "method": "session/set_config_option",
      "params": {
        "configId": "mode",
        "value": "agent-full-access"
      }
    },
    {
      "method": "session/set_config_option",
      "params": {
        "configId": "mode",
        "value": "read-only"
      }
    },
    {
      "method": "session/set_config_option",
      "params": {
        "configId": "collaboration_mode",
        "value": "plan"
      }
    }
  ],
  "absent": [
    {
      "kind": "modeMismatch"
    }
  ]
}
