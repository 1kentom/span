// Accept edits on Codex: the agent stays in agent (Auto review). An edit inside the workspace is allowed by Span without a prompt (allow once, reason accept_edits_workspace); an edit outside the workspace and a command still prompt. When Codex resets its own preset mid turn (config_option_update to agent-full-access), Span reports modeMismatch, sets agent back once, and the bypass notice is raised and cleared.
// Option shapes as codex-acp 2.3.0 live captures (sanitised); the mid-turn reset is a constructed case after T3 Code issue 13987. Not run live.
{"on": "initialize", "result": {"protocolVersion": 1, "agentInfo": {"name": "@agentclientprotocol/codex-acp", "title": "Codex", "version": "2.3.0"}, "agentCapabilities": {"loadSession": true, "sessionCapabilities": {"list": {}, "close": {}}}, "authMethods": []}}
{"on": "session/new", "result": {"sessionId": "x-1", "configOptions": [{"id": "mode", "name": "Mode", "category": "mode", "type": "select", "currentValue": "agent", "options": [{"value": "read-only", "name": "Read-only"}, {"value": "workspace-write", "name": "Workspace access"}, {"value": "agent", "name": "Auto review"}, {"value": "agent-full-access", "name": "Full access"}]}, {"id": "collaboration_mode", "name": "Collaboration mode", "category": "collaboration_mode", "type": "select", "currentValue": "default", "options": [{"value": "default", "name": "Default"}, {"value": "plan", "name": "Plan"}]}]}}
{"on": "session/set_config_option", "result": {"configOptions": [{"id": "mode", "name": "Mode", "category": "mode", "type": "select", "currentValue": "agent", "options": [{"value": "read-only", "name": "Read-only"}, {"value": "workspace-write", "name": "Workspace access"}, {"value": "agent", "name": "Auto review"}, {"value": "agent-full-access", "name": "Full access"}]}, {"id": "collaboration_mode", "name": "Collaboration mode", "category": "collaboration_mode", "type": "select", "currentValue": "default", "options": [{"value": "default", "name": "Default"}, {"value": "plan", "name": "Plan"}]}]}}
{"on": "session/prompt", "before": [{"request": {"method": "session/request_permission", "params": {"toolCall": {"toolCallId": "e1", "title": "Edit src/main.rs", "kind": "edit", "status": "pending", "locations": [{"path": "$ROOT/src/main.rs"}]}, "options": [{"optionId": "allow", "name": "Allow", "kind": "allow_once"}, {"optionId": "always", "name": "Always allow", "kind": "allow_always"}, {"optionId": "reject", "name": "Reject", "kind": "reject_once"}]}}}, {"request": {"method": "session/request_permission", "params": {"toolCall": {"toolCallId": "e2", "title": "Edit /etc/hosts", "kind": "edit", "status": "pending", "locations": [{"path": "/etc/hosts"}]}, "options": [{"optionId": "allow", "name": "Allow", "kind": "allow_once"}, {"optionId": "always", "name": "Always allow", "kind": "allow_always"}, {"optionId": "reject", "name": "Reject", "kind": "reject_once"}]}}}, {"request": {"method": "session/request_permission", "params": {"toolCall": {"toolCallId": "x1", "title": "Run git status", "kind": "execute", "status": "pending", "rawInput": {"command": ["bash", "-lc", "git status"]}}, "options": [{"optionId": "allow", "name": "Allow", "kind": "allow_once"}, {"optionId": "always", "name": "Always allow", "kind": "allow_always"}, {"optionId": "reject", "name": "Reject", "kind": "reject_once"}]}}}, {"update": {"sessionUpdate": "config_option_update", "configOptions": [{"id": "mode", "name": "Mode", "category": "mode", "type": "select", "currentValue": "agent-full-access", "options": [{"value": "read-only", "name": "Read-only"}, {"value": "workspace-write", "name": "Workspace access"}, {"value": "agent", "name": "Auto review"}, {"value": "agent-full-access", "name": "Full access"}]}, {"id": "collaboration_mode", "name": "Collaboration mode", "category": "collaboration_mode", "type": "select", "currentValue": "default", "options": [{"value": "default", "name": "Default"}, {"value": "plan", "name": "Plan"}]}]}}, {"sleep": 300}], "result": {"stopReason": "end_turn"}}
